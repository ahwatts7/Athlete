                  {exp===`c${i}`&&<div style={{marginTop:10,paddingTop:10,borderTop:`1px solid ${G.border}`,fontFamily:F,fontSize:13,fontWeight:300,color:"#fff",lineHeight:1.7}}>Buy 2–3 years used. Saves 25–30% off new. Start your car fund now — $50/month compounding over 7 years grows meaningfully.</div>}
                </Card>
