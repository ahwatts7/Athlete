  const [trans,setTrans]=useState(null);
  const [theme,setTheme]=useState(PRESETS[0]); // Pure Black default
  const [accents,setAccents]=useState({...DEFAULT_ACCENTS});
  const [settingsOpen,setSettingsOpen]=useState(false);
  const [todos,setTodos]=useStore("plan_todos",[
    {id:1,text:"Set up Insense profile", priority:"Critical",time:"10:00",recurrence:"Once",  done:false,date:now.toISOString().split("T")[0]},
    {id:2,text:"Film UGC intro video",   priority:"High",    time:"14:00",recurrence:"Once",  done:false,date:now.toISOString().split("T")[0]},
    {id:3,text:"Apply to 3 brand deals", priority:"High",    time:"",     recurrence:"Weekly",done:false,date:now.toISOString().split("T")[0]},
  ]);
  const LABELS={finance:"FINANCES",plan:"PLAN",workout:"WORKOUT"};
  const launch=id=>{setTrans(LABELS[id]);setTimeout(()=>{setApp(id);setTrans(null);},1800);};
  const G=makeG(theme);
  const A={
    workout:makeA(accents.workout),
    finance:makeA(accents.finance),
    plan:   makeA(accents.plan),
  };
  const transCSS=`@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap');@keyframes expandWord{from{opacity:0;letter-spacing:2px;font-size:28px}to{opacity:1;letter-spacing:14px;font-size:44px}}`;
  return (
    <ThemeCtx.Provider value={{G,A}}>
      {trans&&(
        <div style={{position:"fixed",inset:0,background:G.bg,display:"flex",alignItems:"center",justifyContent:"center",zIndex:9999}}>
          <style>{transCSS}</style>
          <div style={{fontFamily:F,fontWeight:700,color:"#fff",textTransform:"uppercase",animation:"expandWord 1.4s cubic-bezier(0.16,1,0.3,1) both"}}>{trans}</div>
        </div>
      )}
      {!trans&&app==="launcher"&&<LauncherApp onLaunch={launch} todos={todos} settingsOpen={settingsOpen} setSettingsOpen={setSettingsOpen}/>}
      {!trans&&app==="finance" &&<FinanceApp  onBack={()=>setApp("launcher")} todos={todos}/>}
      {!trans&&app==="plan"    &&<PlanApp     onBack={()=>setApp("launcher")} todos={todos} setTodos={setTodos}/>}
      {!trans&&app==="workout" &&<WorkoutApp  onBack={()=>setApp("launcher")} todos={todos}/>}
      <Settings open={settingsOpen} onClose={()=>setSettingsOpen(false)} theme={theme} setTheme={setTheme} accents={accents} setAccents={setAccents}/>
    </ThemeCtx.Provider>
  );
}
