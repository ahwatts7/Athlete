                <div><div style={{fontFamily:F,fontSize:11,fontWeight:400,letterSpacing:3,color:G.dim,textTransform:"uppercase",marginBottom:6}}>DATE</div><input style={iS} type="date" value={form.date} onChange={e=>setForm(f=>({...f,date:e.target.value}))}/></div>
              </div>
              <button onClick={addTodo} style={{background:acc.main,color:"#fff",padding:14,borderRadius:4,fontFamily:F,fontSize:16,fontWeight:600,letterSpacing:2,cursor:"pointer"}}>ADD TASK</button>
