// ═══════════════════════════════════════════════════════
// CALENDAR — Sunday first
// ═══════════════════════════════════════════════════════
function CalendarView({todos,accent}) {
  const {G,A}=useTheme();
  const [cm,setCm]=useState(now.getMonth());
  const [cy,setCy]=useState(now.getFullYear());
  const [sel,setSel]=useState(now.getDate());
  const offset=new Date(cy,cm,1).getDay(); // 0=Sun → Sunday-first, no adjustment needed
  const daysInMonth=new Date(cy,cm+1,0).getDate();
  const getEvents=day=>{
    const d=new Date(cy,cm,day);
    const dow=d.getDay(); // 0=Sun
    const schedIdx=dow===0?6:dow-1; // SCHED is Mon-indexed
    const ws=SCHED[schedIdx];
    const dateStr=`${cy}-${String(cm+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
    const evs=[];
    if(ws.name!=="Rest") evs.push({label:`${ws.emoji} ${ws.name} Day`,sub:ws.type,ac:A.workout.light,type:"workout"});
    todos.filter(t=>{
      if(t.recurrence==="Daily") return true;
      if(t.recurrence==="Weekly") return new Date(t.date).getDay()===d.getDay();
      if(t.recurrence==="Monthly") return new Date(t.date).getDate()===d.getDate();
      return t.date===dateStr;
    }).forEach(t=>evs.push({label:t.text,sub:t.priority,ac:A.plan.light,done:t.done,type:"todo"}));
    return evs;
  };
  const selEvs=sel?getEvents(sel):[];
  return (
    <div>
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:16}}>
        <button onClick={()=>{if(cm===0){setCm(11);setCy(y=>y-1);}else setCm(m=>m-1);setSel(null);}} style={{fontFamily:F,fontSize:22,fontWeight:300,padding:"4px 12px",color:G.t3,background:"none",border:"none",cursor:"pointer"}}>‹</button>
        <div style={{fontFamily:F,fontSize:17,fontWeight:600,letterSpacing:2,color:"#fff"}}>{MFULL[cm].toUpperCase()} {cy}</div>
        <button onClick={()=>{if(cm===11){setCm(0);setCy(y=>y+1);}else setCm(m=>m+1);setSel(null);}} style={{fontFamily:F,fontSize:22,fontWeight:300,padding:"4px 12px",color:G.t3,background:"none",border:"none",cursor:"pointer"}}>›</button>
      </div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(7,1fr)",marginBottom:6}}>
        {["S","M","T","W","T","F","S"].map((d,i)=>(
          <div key={i} style={{textAlign:"center",fontFamily:F,fontSize:10,fontWeight:400,letterSpacing:1,color:G.dim}}>{d}</div>
        ))}
      </div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:3,marginBottom:16}}>
        {Array.from({length:offset}).map((_,i)=><div key={`e${i}`}/>)}
        {Array.from({length:daysInMonth}).map((_,i)=>{
          const day=i+1,isToday=day===now.getDate()&&cm===now.getMonth()&&cy===now.getFullYear(),isSel=day===sel;
          const evs=getEvents(day);
          return (
            <button key={day} onClick={()=>setSel(day)} style={{background:isSel?accent:isToday?G.raised:"none",border:`1px solid ${isSel?accent:isToday?G.borderM:G.border}`,borderRadius:4,padding:"7px 2px",display:"flex",flexDirection:"column",alignItems:"center",gap:3,cursor:"pointer",transition:"all 0.15s"}}>
              <span style={{fontFamily:F,fontSize:13,fontWeight:isToday?"600":"300",color:isSel?"#fff":isToday?accent:"#fff"}}>{day}</span>
              <div style={{display:"flex",gap:2}}>
                {evs.some(e=>e.type==="workout")&&<div style={{width:4,height:4,borderRadius:"50%",background:isSel?"#fff":A.workout.light}}/>}
                {evs.some(e=>e.type==="todo")   &&<div style={{width:4,height:4,borderRadius:"50%",background:isSel?"#fff":A.plan.light}}/>}
              </div>
            </button>
          );
        })}
      </div>
      {sel&&(
        <Card>
          <div style={{fontFamily:F,fontSize:15,fontWeight:400,letterSpacing:1,color:"#fff",marginBottom:12}}>{MFULL[cm].toUpperCase()} {sel}</div>
          {selEvs.length===0
            ?<div style={{fontFamily:F,fontSize:14,fontWeight:300,color:G.dim,textAlign:"center",padding:"12px 0"}}>Nothing scheduled</div>
            :selEvs.map((ev,i)=>(
              <div key={i} style={{display:"flex",gap:10,padding:"10px 0",borderBottom:i<selEvs.length-1?`1px solid ${G.border}`:"none",opacity:ev.done?0.4:1}}>
                <div style={{width:2,background:ev.ac,borderRadius:2,alignSelf:"stretch",flexShrink:0,minHeight:18}}/>
                <div>
                  <div style={{fontFamily:F,fontSize:14,fontWeight:400,color:ev.done?G.dim:"#fff",textDecoration:ev.done?"line-through":"none"}}>{ev.label}</div>
                  <div style={{fontFamily:F,fontSize:11,fontWeight:300,letterSpacing:2,color:G.dim,marginTop:3,textTransform:"uppercase"}}>{ev.sub}</div>
                </div>
              </div>
            ))
          }
        </Card>
      )}
    </div>
  );
}

