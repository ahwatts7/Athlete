  const todayTodos=todos.filter(t=>{if(t.recurrence==="Daily")return true;if(t.recurrence==="Weekly")return new Date(t.date).getDay()===now.getDay();if(t.recurrence==="Monthly")return new Date(t.date).getDate()===now.getDate();return t.date===todayStr;});
  const importList=()=>{const lines=imp.split("\n").filter(l=>l.trim());setTodos(t=>[...t,...lines.map(l=>({id:Date.now()+Math.random(),text:l.trim(),priority:"Medium",time:"",recurrence:"Once",date:todayStr,done:false}))]);setImp("");showToast(`${lines.length} tasks imported`);setTab("today");};
