              {[{name:"Ford Explorer ST",price:"$35–50k used",timeline:"3–5 yrs",ok:true},{name:"Toyota 4Runner TRD Pro",price:"$45–60k used",timeline:"3–5 yrs",ok:true},{name:"Porsche 911 (used)",price:"$80–150k",timeline:"7–10 yrs",ok:false},{name:"Aston Martin Vantage",price:"$80–130k",timeline:"8–10 yrs",ok:false}].map((car,i)=>(
