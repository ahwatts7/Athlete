function AppSplash({word,onDone}) {
  const {G}=useTheme();
  const [phase,setPhase]=useState("expand");
  useEffect(()=>{const t=setTimeout(()=>{setPhase("done");setTimeout(onDone,400);},1600);return()=>clearTimeout(t);},[]);
  return (
    <div style={{position:"fixed",inset:0,background:G.bg,display:"flex",alignItems:"center",justifyContent:"center",zIndex:9999,opacity:phase==="done"?0:1,transition:"opacity 0.4s ease"}}>
      <style>{`@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap');@keyframes expandWord{from{opacity:0;letter-spacing:2px;font-size:28px}to{opacity:1;letter-spacing:14px;font-size:44px}}`}</style>
      <div style={{fontFamily:F,fontWeight:700,color:"#fff",textTransform:"uppercase",animation:"expandWord 1.2s cubic-bezier(0.16,1,0.3,1) both"}}>{word}</div>
    </div>
  );
}

// ═══════════════════════════════════════════════════════
// SETTINGS PANEL
// ═══════════════════════════════════════════════════════
function Settings({open,onClose,theme,setTheme,accents,setAccents}) {
  const {G}=useTheme();
  const [closing,setClosing]=useState(false);
  const [cBg,setCBg]=useState(theme.bg);
  const [cSurf,setCSurf]=useState(theme.surface);
  const [cCard,setCCard]=useState(theme.card);
  const close=()=>{setClosing(true);setTimeout(()=>{setClosing(false);onClose();},280);};
  const applyPreset=p=>{setTheme(p);setCBg(p.bg);setCSurf(p.surface);setCCard(p.card);};
  const applyCustom=()=>setTheme({id:"custom",name:"Custom",bg:cBg,surface:cSurf,card:cCard,raised:cCard});
  if(!open&&!closing) return null;
  const panelCSS=`@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap');@keyframes slideInR{from{transform:translateX(100%)}to{transform:translateX(0)}}@keyframes slideOutR{from{transform:translateX(0)}to{transform:translateX(100%)}}`;
  return (
    <div style={{position:"fixed",inset:0,zIndex:500,display:"flex"}}>
      <style>{panelCSS}</style>
      <div onClick={close} style={{flex:1,background:"rgba(0,0,0,0.6)"}}/>
      <div style={{width:"85%",maxWidth:380,background:G.surface,height:"100%",overflowY:"auto",boxShadow:"-8px 0 40px rgba(0,0,0,0.7)",animation:closing?"slideOutR 0.28s ease both":"slideInR 0.32s ease both"}}>
        {/* Header */}
        <div style={{padding:"20px 20px 14px",borderBottom:`1px solid ${G.border}`,display:"flex",justifyContent:"space-between",alignItems:"center",position:"sticky",top:0,background:G.surface,zIndex:10}}>
          <div style={{fontFamily:F,fontSize:20,fontWeight:700,letterSpacing:3,color:"#fff"}}>SETTINGS</div>
          <button onClick={close} style={{color:G.dim,fontSize:26,lineHeight:1,background:"none",border:"none",cursor:"pointer"}}>×</button>
        </div>
        <div style={{padding:"18px 20px"}}>

          {/* Preset themes */}
          <div style={{fontFamily:F,fontSize:11,fontWeight:400,letterSpacing:3,color:G.dim,textTransform:"uppercase",marginBottom:12}}>BACKGROUND THEME</div>
          <div style={{display:"flex",flexDirection:"column",gap:8,marginBottom:22}}>
            {PRESETS.map(p=>(
              <button key={p.id} onClick={()=>applyPreset(p)}
                style={{display:"flex",alignItems:"center",gap:12,padding:"11px 14px",borderRadius:4,border:`1px solid ${theme.id===p.id?"#fff":G.border}`,background:p.bg,cursor:"pointer",transition:"border 0.15s",fontFamily:F}}>
                <div style={{display:"flex",gap:4}}>
                  {[p.bg,p.surface,p.card].map((c,i)=><div key={i} style={{width:14,height:14,borderRadius:3,background:c,border:"1px solid rgba(255,255,255,0.2)"}}/>)}
                </div>
                <span style={{fontFamily:F,fontSize:14,fontWeight:400,color:"#fff",flex:1,textAlign:"left"}}>{p.name}</span>
                {theme.id===p.id&&<span style={{color:"#fff",fontSize:14}}>✓</span>}
              </button>
            ))}
          </div>

          {/* Custom pickers */}
          <div style={{fontFamily:F,fontSize:11,fontWeight:400,letterSpacing:3,color:G.dim,textTransform:"uppercase",marginBottom:12}}>CUSTOM COLOURS</div>
          <div style={{display:"flex",flexDirection:"column",gap:10,marginBottom:10}}>
            {[{label:"Background",val:cBg,set:setCBg},{label:"Surfaces",val:cSurf,set:setCSurf},{label:"Cards",val:cCard,set:setCCard}].map(r=>(
              <div key={r.label} style={{display:"flex",alignItems:"center",gap:10}}>
                <input type="color" value={r.val} onChange={e=>r.set(e.target.value)} style={{width:34,height:34,borderRadius:4,border:`1px solid ${G.border}`,background:"none",cursor:"pointer",padding:2}}/>
                <span style={{fontFamily:F,fontSize:14,fontWeight:300,color:"#fff",flex:1}}>{r.label}</span>
                <span style={{fontFamily:F,fontSize:10,color:G.dim,letterSpacing:1}}>{r.val.toUpperCase()}</span>
              </div>
            ))}
          </div>
          <button onClick={applyCustom} style={{width:"100%",padding:"11px 0",background:G.raised,border:`1px solid ${G.borderM}`,borderRadius:4,fontFamily:F,fontSize:13,fontWeight:500,letterSpacing:2,color:"#fff",marginBottom:24,textTransform:"uppercase",cursor:"pointer"}}>APPLY CUSTOM</button>

          {/* Per-app accents */}
          <div style={{fontFamily:F,fontSize:11,fontWeight:400,letterSpacing:3,color:G.dim,textTransform:"uppercase",marginBottom:12}}>APP ACCENT COLOURS</div>
          <div style={{display:"flex",flexDirection:"column",gap:14,marginBottom:22}}>
            {[{key:"workout",label:"Workout"},{key:"finance",label:"Finances"},{key:"plan",label:"Plan"}].map(app=>(
              <div key={app.key} style={{display:"flex",alignItems:"center",gap:12}}>
                <input type="color" value={accents[app.key]} onChange={e=>setAccents(a=>({...a,[app.key]:e.target.value}))} style={{width:34,height:34,borderRadius:4,border:`1px solid ${G.border}`,background:"none",cursor:"pointer",padding:2}}/>
                <div style={{flex:1}}>
                  <div style={{fontFamily:F,fontSize:15,fontWeight:500,color:"#fff"}}>{app.label}</div>
                  <div style={{fontFamily:F,fontSize:11,color:G.dim,letterSpacing:1}}>{accents[app.key].toUpperCase()}</div>
                </div>
                <button onClick={()=>setAccents(a=>({...a,[app.key]:DEFAULT_ACCENTS[app.key]}))} style={{fontFamily:F,fontSize:10,color:G.dim,letterSpacing:1,border:`1px solid ${G.border}`,borderRadius:3,padding:"4px 8px",background:"none",cursor:"pointer"}}>RESET</button>
              </div>
            ))}
          </div>
          <button onClick={()=>{setTheme(PRESETS[0]);setAccents({...DEFAULT_ACCENTS});setCBg(PRESETS[0].bg);setCSurf(PRESETS[0].surface);setCCard(PRESETS[0].card);}}
            style={{width:"100%",padding:"11px 0",background:"none",border:`1px solid ${G.border}`,borderRadius:4,fontFamily:F,fontSize:12,fontWeight:400,letterSpacing:2,color:G.dim,textTransform:"uppercase",cursor:"pointer"}}>
            RESET ALL TO DEFAULTS
          </button>
        </div>
      </div>
    </div>
  );
}

